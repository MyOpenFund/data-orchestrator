# Per-machine configuration for data-orchestrator.
#
# Copy this file to ".env" and set the data-source roots for THIS machine.
# ".env" is git-ignored, so each machine can keep its own paths.
#
#   cp .env.example .env      # macOS / Linux
#   Copy-Item .env.example .env   # PowerShell
#
# Each data source has its own *_ROOT key pointing at the folder that contains
# the source's "raw/" directory. A CLI flag (e.g. --root) always overrides these.

# --- cb_corpus ---------------------------------------------------------------
# Folder that contains "raw/<bank>/<doctype>/<year>/<doc_id>.<ext>".
CB_CORPUS_ROOT=/path/to/data/cb_corpus

# --- company_corpus -----------------------------------------------------------
# SEC EDGAR micro layer. Folder that holds the company_corpus data dir (the one
# its renderer writes the page-anchored PDFs / cleaned text into). Optional: if
# unset, company_corpus falls back to its own default data dir. A CLI --root
# always overrides this.
COMPANY_CORPUS_ROOT=/path/to/data/company_corpus

# --- future sources ----------------------------------------------------------
# Add one *_ROOT per new source connector as they are added, e.g.:
# REPEC_ROOT=

# --- Ingestion engine (eigenmind) ------------------------------------------------
# Path to the local clone of the eigenmind fork (pip install -e $EIGENMIND_PATH)
EIGENMIND_PATH=/path/to/eigenmind
# Vault Postgres (rag_ingestions state + wave-2 selection)
DATABASE_URL=postgresql://user:pass@host:5432/documents

# --- data-orchestrator options -----------------------------------------------
# Both optional; leave commented out to keep the built-in defaults.
# Embedding model behind the routed collection name (default
# intfloat/multilingual-e5-base; CI swaps in a tiny model for integration runs).
# DATA_ORCHESTRATOR_EMBEDDING_MODEL=
# Directory for the --no-vault JSON-lines ledger and run reports (default
# <repo>/state).
# DATA_ORCHESTRATOR_STATE_DIR=
